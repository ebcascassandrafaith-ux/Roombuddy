<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Member B: "My Listings" screen. Controller: MyListingsController -->
<BorderPane styleClass="page" stylesheets="@owner.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.template.owner.MyListingsController">

    <top>
        <HBox styleClass="page-header" alignment="CENTER_LEFT" spacing="12">
            <Label text="My Listings" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="postButton" text="+  Post a listing" styleClass="primary-button"
                    onAction="#onPostListing"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="grid-scroll">
            <VBox fx:id="listBox" spacing="12" styleClass="grid-content"/>
        </ScrollPane>
    </center>
</BorderPane>
