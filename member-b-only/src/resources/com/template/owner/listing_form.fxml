<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Member B: Post a listing / Edit listing (opens in its own window). Controller: ListingFormController -->
<ScrollPane fitToWidth="true" hbarPolicy="NEVER" stylesheets="@owner.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.template.owner.ListingFormController">

    <VBox spacing="14" styleClass="form-page">

        <Label fx:id="formTitle" text="Post a listing" styleClass="page-title"/>
        <Label fx:id="editNote" styleClass="muted" wrapText="true"/>

        <VBox spacing="10" styleClass="panel">
            <Label text="Property details" styleClass="panel-title"/>

            <Label text="Property name *" styleClass="filter-label"/>
            <TextField fx:id="nameField" promptText="e.g. Casa Linda Dormitory"/>

            <HBox spacing="14">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Property type *" styleClass="filter-label"/>
                    <ComboBox fx:id="typeCombo" maxWidth="Infinity" promptText="Choose…"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Room type *" styleClass="filter-label"/>
                    <ComboBox fx:id="roomCombo" maxWidth="Infinity" promptText="Choose…"/>
                </VBox>
            </HBox>

            <HBox spacing="14">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Barangay *" styleClass="filter-label"/>
                    <TextField fx:id="barangayField" promptText="e.g. Lapasan"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Price per month (₱) *" styleClass="filter-label"/>
                    <TextField fx:id="priceField" promptText="e.g. 3500"/>
                </VBox>
            </HBox>

            <Label text="Address *" styleClass="filter-label"/>
            <TextField fx:id="addressField" promptText="Street, zone / purok, city"/>

            <Label text="Description *" styleClass="filter-label"/>
            <TextArea fx:id="descriptionArea" prefRowCount="3" wrapText="true"
                      promptText="Describe the room and the property"/>
        </VBox>

        <VBox spacing="10" styleClass="panel">
            <Label text="Amenities" styleClass="panel-title"/>
            <Label text="Tick what is available. If it costs extra each month, type the amount."
                   styleClass="muted" wrapText="true"/>
            <FlowPane fx:id="amenityPane" hgap="18" vgap="10"/>
        </VBox>

        <VBox spacing="10" styleClass="panel">
            <Label text="House rules *" styleClass="panel-title"/>
            <TextArea fx:id="rulesArea" prefRowCount="4" wrapText="true"
                      promptText="One rule per line, e.g. Curfew at 10 PM"/>
        </VBox>

        <VBox spacing="10" styleClass="panel">
            <Label text="Photos *" styleClass="panel-title"/>
            <Label fx:id="photoHint" styleClass="muted" wrapText="true"/>
            <FlowPane fx:id="photoPane" hgap="10" vgap="10"/>
            <HBox>
                <Button text="Add photos…" styleClass="outline-button" onAction="#onAddPhotos"/>
            </HBox>
        </VBox>

        <VBox spacing="10" styleClass="panel">
            <Label text="Property documents *" styleClass="panel-title"/>
            <Label text="Land title, business permit, barangay clearance… (PDF, JPG or PNG, max 5 MB). Only the admin sees these."
                   styleClass="muted" wrapText="true"/>
            <VBox fx:id="docsBox" spacing="6"/>
            <HBox>
                <Button text="Add document…" styleClass="outline-button" onAction="#onAddDocument"/>
            </HBox>
        </VBox>

        <Label fx:id="errorLabel" styleClass="error-text" wrapText="true"/>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Cancel" styleClass="ghost-button" onAction="#onCancel"/>
            <Button fx:id="submitButton" text="Submit for approval" styleClass="primary-button"
                    onAction="#onSubmit"/>
        </HBox>
    </VBox>
</ScrollPane>
