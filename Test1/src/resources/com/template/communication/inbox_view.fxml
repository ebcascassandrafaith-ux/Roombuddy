<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="communication-page"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.template.communication.InboxController">
    <HBox alignment="CENTER_LEFT" styleClass="communication-header" spacing="12">
        <Button text="Back" styleClass="secondary-button" onAction="#onBack"/>
        <Label text="Messages" styleClass="communication-title"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="page-scroll">
        <VBox fx:id="conversationsBox" spacing="10" styleClass="communication-content"/>
    </ScrollPane>
</VBox>
