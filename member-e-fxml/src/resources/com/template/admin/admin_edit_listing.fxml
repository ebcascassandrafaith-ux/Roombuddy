<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<GridPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
          hgap="10" vgap="10" fx:controller="com.template.admin.controller.EditListingController">
    <padding><Insets bottom="15" left="15" right="15" top="15"/></padding>
        <Label text="Property name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nameField" prefWidth="320" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Property type:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="typeBox" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextArea fx:id="descArea" prefRowCount="3" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="Barangay:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="barangayField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Label text="Address:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="addressField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        <Label text="Price:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <TextField fx:id="priceField" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
        <Label text="Room type:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <ComboBox fx:id="roomBox" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
        <Label text="House rules:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
        <TextArea fx:id="rulesArea" prefRowCount="3" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
</GridPane>
