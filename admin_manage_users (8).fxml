<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.template.controllers.ManageUsersController">
    <stylesheets><URL value="@../admin.css"/></stylesheets>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="admin-topbar">
            <padding><Insets bottom="12" left="12" right="12" top="12"/></padding>
            <Button onAction="#onBack" text="&lt; Dashboard"/>
            <Label styleClass="admin-title" text="Manage Users"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="12">
            <padding><Insets bottom="15" left="15" right="15" top="15"/></padding>
            <TableView fx:id="table" prefHeight="400">
                <columns>
                    <TableColumn prefWidth="60" text="ID">
                        <cellValueFactory><PropertyValueFactory property="userId"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="180" text="Full Name">
                        <cellValueFactory><PropertyValueFactory property="fullName"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="240" text="Email">
                        <cellValueFactory><PropertyValueFactory property="email"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="120" text="Contact">
                        <cellValueFactory><PropertyValueFactory property="contactNumber"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="70" text="Role">
                        <cellValueFactory><PropertyValueFactory property="role"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="90" text="Status">
                        <cellValueFactory><PropertyValueFactory property="status"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="90" text="ID Verified">
                        <cellValueFactory><PropertyValueFactory property="idVerified"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn prefWidth="160" text="Created">
                        <cellValueFactory><PropertyValueFactory property="createdAt"/></cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button onAction="#onDetails" text="View Details"/>
                <Button onAction="#onSuspend" text="Suspend"/>
                <Button onAction="#onBan" text="Ban"/>
                <Button onAction="#onRestore" text="Restore"/>
                <Button onAction="#onDelete" text="Delete"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
